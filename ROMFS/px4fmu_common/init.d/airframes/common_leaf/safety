param set-default COM_DISARM_LAND -1.0        # Disarm timeout after landing (-1 = disabled)
param set-default COM_DISARM_PRFLT -1.0f      # Preflight disarm timeout (-1 = disabled, float format)
param set-default MAN_ARM_GESTURE 0           # Manual arming gesture (0 = disabled)
